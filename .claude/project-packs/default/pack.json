{
  "schema_version": "harness.project-pack.v1",
  "id": "default",
  "description": "Lean default runtime: native model instructions, deterministic QA, safe sync, and image overlays without bulk agents, skills, commands, rules, or orchestration.",
  "image_policy_required_surfaces": [
    ".claude/rules/common/imagegen-marketing-assets.md"
  ],
  "paths": [
    "CLAUDE.md",
    ".claude/hooks",
    ".claude/evals",
    ".claude/registry/contracts",
    ".claude/registry/design/source-policy.json",
    ".claude/registry/projects",
    ".claude/registry/providers",
    ".claude/project-packs/default",
    ".claude/project-packs/default.scope.json",
    ".claude/project-packs/image-generation",
    ".claude/project-packs/img2threejs",
    ".claude/skills/design-harness/scripts/detect-design-slop.mjs",
    ".claude/skills/korean-typography-quality/scripts/validate_korean_typography.py",
    ".claude/statusline.py",
    "scripts/harness_runtime_lib.py",
    "scripts/harness-provider.py",
    "scripts/harness-doctor.py",
    "scripts/harness-sync.py",
    "scripts/context-pack-gate.py",
    "scripts/sync-to-projects.sh"
  ],
  "links": {
    "AGENTS.md": "CLAUDE.md",
    "GEMINI.md": "CLAUDE.md",
    ".agents/skills": "../.claude/skills"
  },
  "settings_merges": [
    {
      "target": ".claude/settings.json",
      "format": "json",
      "operation": "append-if-missing",
      "path": ["hooks", "PreToolUse"],
      "match": {"matcher": "Bash"},
      "append_path": ["hooks"],
      "value": {
        "type": "command",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/git-push-guard.sh"
      }
    },
    {
      "target": ".claude/settings.json",
      "format": "json",
      "operation": "append-if-missing",
      "path": ["hooks", "PostToolUse"],
      "match": {"matcher": "Edit|Write"},
      "append_path": ["hooks"],
      "value": {
        "type": "command",
        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.sh"
      }
    }
  ],
  "exclude": [
    "**/.git/**",
    "**/__pycache__/**",
    "**/*.pyc",
    ".claude/logs/**",
    ".claude/settings*.json",
    ".mcp.json",
    ".env*"
  ]
}
